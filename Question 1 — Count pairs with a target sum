
#include <stdio.h>

int main() {
    int n, target;
    int arr[1000];
    long long count = 0;

    scanf("%d %d", &n, &target);

    // Read array elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Count pairs whose sum equals target
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if ((long long)arr[i] + arr[j] == target) {
                count++;
            }
        }
    }

    printf("%lld\n", count);

    return 0;
}
