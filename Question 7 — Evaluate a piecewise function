
#include <stdio.h>

long long calculate(int x) {
    if (x < 0) {
        return (long long)x * x + 2LL * x + 1;
    }
    else if (x >= 0 && x < 10) {
        return 3LL * x + 2;
    }
    else {
        return 5LL * x - 7;
    }
}

int main() {
    int x;

    scanf("%d", &x);

    printf("%lld\n", calculate(x));

    return 0;
}
