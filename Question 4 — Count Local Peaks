
#include <stdio.h>

#define MAX 100

int main() {
    int r, c;
    int matrix[MAX][MAX];
    int peaks = 0;

    scanf("%d %d", &r, &c);

    if (r < 1 || r > MAX || c < 1 || c > MAX) {
        return 0;
    }

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {

            int isPeak = 1;
            int value = matrix[i][j];

            // Check upper neighbour
            if (i > 0 && value <= matrix[i - 1][j]) {
                isPeak = 0;
            }

            // Check lower neighbour
            if (i < r - 1 && value <= matrix[i + 1][j]) {
                isPeak = 0;
            }

            // Check left neighbour
            if (j > 0 && value <= matrix[i][j - 1]) {
                isPeak = 0;
            }

            // Check right neighbour
            if (j < c - 1 && value <= matrix[i][j + 1]) {
                isPeak = 0;
            }

            if (isPeak) {
                peaks++;
            }
        }
    }

    printf("%d\n", peaks);

    return 0;
}
