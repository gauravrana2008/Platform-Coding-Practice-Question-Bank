
#include <stdio.h>

#define MAX 1000

int digitSum(long long num) {
    int sum = 0;

    while (num > 0) {
        sum += num % 10;
        num /= 10;
    }

    return sum;
}

int main() {
    int n;
    long long arr[MAX];
    long long count = 0;

    scanf("%d", &n);

    if (n < 1 || n > MAX) {
        return 0;
    }

    for (int i = 0; i < n; i++) {
        scanf("%lld", &arr[i]);
    }

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {

            if (digitSum(arr[i]) == digitSum(arr[j])) {
                count++;
            }
        }
    }

    printf("%lld\n", count);

    return 0;
}
