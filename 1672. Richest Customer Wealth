
int maximumWealth(int** accounts, int accountsSize, int* accountsColSize) {
    int maxWealth = 0;

    for (int i = 0; i < accountsSize; i++) {
        int wealth = 0;

        // Calculate total wealth of each customer
        for (int j = 0; j < accountsColSize[i]; j++) {
            wealth += accounts[i][j];
        }

        // Update maximum wealth
        if (wealth > maxWealth) {
            maxWealth = wealth;
        }
    }

    return maxWealth;
}
