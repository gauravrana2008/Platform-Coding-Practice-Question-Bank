
#include <stdio.h>

#define MAX 100

int main() {
    int r, c;
    int matrix[MAX][MAX];

    scanf("%d %d", &r, &c);

    if (r < 1 || r > MAX || c < 1 || c > MAX) {
        return 0;
    }

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    // Calculate row sums
    for (int i = 0; i < r; i++) {
        long long sum = 0;

        for (int j = 0; j < c; j++) {
            sum += matrix[i][j];
        }

        if (i > 0) printf(" ");
        printf("%lld", sum);
    }

    printf("\n");

    // Calculate column sums
    for (int j = 0; j < c; j++) {
        long long sum = 0;

        for (int i = 0; i < r; i++) {
            sum += matrix[i][j];
        }

        if (j > 0) printf(" ");
        printf("%lld", sum);
    }

    printf("\n");

    return 0;
}
