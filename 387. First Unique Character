
int firstUniqChar(char* s) {
    int count[26] = {0};

    // Count how many times each character appears
    for (int i = 0; s[i] != '\0'; i++) {
        count[s[i] - 'a']++;
    }

    // Find the first character that appears only once
    for (int i = 0; s[i] != '\0'; i++) {
        if (count[s[i] - 'a'] == 1) {
            return i;
        }
    }

    return -1;
}
