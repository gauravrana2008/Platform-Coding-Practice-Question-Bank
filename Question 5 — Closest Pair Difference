
#include <stdio.h>
#include <stdlib.h>

#define MAX 1000

int main() {
    int n;
    int arr[MAX];
    long long minDiff = 0;

    scanf("%d", &n);

    if (n < 2 || n > MAX) {
        return 0;
    }

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    minDiff = llabs((long long)arr[0] - arr[1]);

    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {

            long long diff = llabs((long long)arr[i] - arr[j]);

            if (diff < minDiff) {
                minDiff = diff;
            }
        }
    }

    printf("%lld\n", minDiff);

    return 0;
}
