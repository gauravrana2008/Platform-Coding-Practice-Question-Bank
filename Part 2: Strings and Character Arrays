
#include <stdio.h>
#include <ctype.h>

#define MAX 1000

int main() {
    char str[MAX];

    int vowels = 0;
    int consonants = 0;
    int digits = 0;
    int spaces = 0;

    fgets(str, MAX, stdin);

    for (int i = 0; str[i] != '\0'; i++) {

        unsigned char ch = (unsigned char)str[i];

        if (isalpha(ch)) {

            char lower = (char)tolower(ch);

            if (lower == 'a' || lower == 'e' ||
                lower == 'i' || lower == 'o' ||
                lower == 'u') {
                vowels++;
            } else {
                consonants++;
            }
        }
        else if (isdigit(ch)) {
            digits++;
        }
        else if (ch == ' ') {
            spaces++;
        }
    }

    printf("%d %d %d %d\n",
           vowels, consonants, digits, spaces);

    return 0;
}
