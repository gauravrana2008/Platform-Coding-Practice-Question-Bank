
#include <stdio.h>

#define MAX 100

int main() {
    int r, c;
    int matrix[MAX][MAX];
    int found = 0;

    scanf("%d %d", &r, &c);

    if (r < 1 || r > MAX || c < 1 || c > MAX) {
        return 0;
    }

    for (int i = 0; i < r; i++) {
        for (int j = 0; j < c; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    for (int i = 0; i < r && !found; i++) {
        for (int j = 0; j < c; j++) {

            int isMin = 1;
            int isMax = 1;

            // Check minimum in its row
            for (int k = 0; k < c; k++) {
                if (matrix[i][k] < matrix[i][j]) {
                    isMin = 0;
                    break;
                }
            }

            // Check maximum in its column
            for (int k = 0; k < r; k++) {
                if (matrix[k][j] > matrix[i][j]) {
                    isMax = 0;
                    break;
                }
            }

            if (isMin && isMax) {
                printf("%d %d %d\n",
                       i + 1, j + 1, matrix[i][j]);

                found = 1;
                break;
            }
        }
    }

    if (!found) {
        printf("None\n");
    }

    return 0;
}
