
#include <stdbool.h>

bool isIsomorphic(char* s, char* t) {
    int mapST[256] = {0};
    int mapTS[256] = {0};

    for (int i = 0; s[i] != '\0'; i++) {
        unsigned char a = s[i];
        unsigned char b = t[i];

        // Check whether the mapping is consistent
        if (mapST[a] != 0 && mapST[a] != b) {
            return false;
        }

        if (mapTS[b] != 0 && mapTS[b] != a) {
            return false;
        }

        // Store mappings
        mapST[a] = b;
        mapTS[b] = a;
    }

    return true;
}
